# ==============================================================================
# KrishiMitra AI — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# Required variables MUST be populated; missing required variables will cause
# the server to abort startup immediately (fail-fast validation).
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED AT STARTUP
# ------------------------------------------------------------------------------

# JWT Secret Key for token signing and authentication (min 8 characters)
# Generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here_min_8_chars

# MongoDB connection string (must start with mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/crop_db

# ML Service URL for crop recommendations and disease detection (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# OPTIONAL (With Defaults)
# ------------------------------------------------------------------------------

# Backend HTTP server port (Default: 5000)
PORT=5000

# Application environment: development | production | test (Default: development)
NODE_ENV=development

# JWT token expiration window (Default: 7d)
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed browser origins (Default: http://localhost:3000)
# Local development (Vite default port):
#   ALLOWED_ORIGINS=http://localhost:3000
# Production (set to your real deployed frontend URL):
#   ALLOWED_ORIGINS=https://your-frontend-domain.com
# Multiple origins:
#   ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# REVERSE PROXY TRUST (Step 24.24 / BLK-02)
# ------------------------------------------------------------------------------
# Determines how Express resolves client IP addresses (req.ip) from X-Forwarded-For headers.
# Critical for accurate rate limiting and access logging when behind a reverse proxy.
#
# Production options:
#   - TRUST_PROXY=1         : Single reverse proxy hop (Nginx, AWS ALB, Render, Cloudflare)
#   - TRUST_PROXY=loopback  : Local reverse proxy on 127.0.0.1 / ::1
#   - TRUST_PROXY=false     : Direct client connections without reverse proxy (default)
#
# SECURITY WARNING: Never set TRUST_PROXY=true in production; blind trust across all hops
# allows malicious clients to spoof client IP via arbitrary X-Forwarded-For headers.
TRUST_PROXY=1

# External Open-Meteo Weather API Base URL (Default in code)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# External Data.gov.in Mandi Market API (Optional — graceful fallback if absent)
MARKET_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_API_KEY=YOUR_API_KEY_HERE

# ------------------------------------------------------------------------------
# AUTHENTICATION RATE LIMITING (GAP-17)
# ------------------------------------------------------------------------------
# Protects POST /api/v1/auth/login and POST /api/v1/auth/register against brute-force
# and credential stuffing attacks using a sliding in-memory window.
#
# Window duration in milliseconds (Default: 900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Maximum permitted requests per route & IP address within the window
# (Default: 10 in production, 100 in development)
AUTH_RATE_LIMIT_MAX=10

# Architecture Note: In-memory rate limiting tracks limits per Node.js process.
# In horizontally scaled multi-replica deployments behind a load balancer,
# each instance tracks its own bucket unless paired with a distributed Redis store.
