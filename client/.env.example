# ==============================================================================
# KrishiMitra AI — Frontend Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` in the `client/` root directory for custom configuration.
#
# IMPORTANT SECURITY WARNING:
# All variables prefixed with `VITE_` are statically embedded into client-side
# JavaScript bundles during the Vite build process and are publicly readable by
# anyone inspecting browser network calls or bundle source code.
#
# NEVER define secret API keys, database credentials, JWT secrets, private tokens,
# or backend passwords in this file or any client `.env` files.
# ==============================================================================

# Base URL for the KrishiMitra Node.js Express backend API.
# Development default (if omitted): http://localhost:5000/api/v1
# Production deployment example: https://api.krishimitra.example.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
